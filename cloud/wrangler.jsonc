{
  "name": "event-crm-luma",
  "main": "src/worker.mjs",
  "compatibility_date": "2026-10-20",
  "workers_dev": true,
  "preview_urls": false,
  "assets": {"directory":"./public", "binding":"ASSETS", "run_worker_first":["/api/*"], "not_found_handling":"single-page-application"},
  "durable_objects": {"bindings":[
    {"name":"WORKSPACES","class_name":"Workspace"},
    {"name":"CONTROL","class_name":"Control"}
  ]},
  "migrations": [{"tag":"v1","new_sqlite_classes":["Workspace","Control"]}],
  "vars": {"MONTHLY_RESEARCH_MICRO_USD":"40000000", "LIVE_ADMISSION":"open"},
  "observability": {"enabled":false}
}
